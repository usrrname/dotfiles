{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/instructions.md"
  ],
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8788/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "mimo-v2.5-free": {
          "name": "MiMo-V2.5 Free",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "laguna-s-2.1-free": {
          "name": "Laguna S 2.1 Free",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "ling-3.0-tiny-free": {
          "name": "Ling-3.0-tiny Free",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "longcat-2.0-free": {
          "name": "LongCat-2.0 Free",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        },
        "nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra Free",
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      }
    }
  }
}
