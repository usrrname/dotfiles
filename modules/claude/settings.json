{
  "permissions": {
    "allow": [],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree.sh\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree.sh\" clean"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.claude/hooks/peon-ping/peon.sh ] && $HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.claude/hooks/peon-ping/peon.sh ] && $HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.claude/hooks/peon-ping/peon.sh ] && $HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x $HOME/.claude/hooks/peon-ping/peon.sh ] && $HOME/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "sh $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {},
  "extraKnownMarketplaces": {
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    }
  },
  "effortLevel": "high",
  "advisorModel": "sonnet",
  "promptSuggestionEnabled": false,
  "disableBundledSkills": true,
  "skillOverrides": {
    "atlassian:capture-tasks-from-meeting-notes": "off",
    "atlassian:generate-status-report": "off",
    "atlassian:jira-sprint-dashboard": "off",
    "atlassian:search-company-knowledge": "off",
    "atlassian:spec-to-backlog": "off",
    "atlassian:triage-issue": "off"
  },
  "autoUpdatesChannel": "stable",
  "tui": "default",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true,
  "voiceEnabled": true
}
