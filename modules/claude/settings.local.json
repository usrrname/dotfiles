{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Read(//opt/homebrew/Cellar/opencode/1.16.2/bin/**)",
      "Bash(brew list *)",
      "Bash(/opt/homebrew/bin/opencode --version)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "op signin --account my.1password.ca 2>/dev/null || true",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jenc/.local/bin/headroom wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jenc/.local/bin/headroom init hook ensure --profile init-jenc-0a9ff3d3 --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jenc/.local/bin/headroom init hook ensure --profile init-jenc-0a9ff3d3 --marker headroom-init-claude",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "headroom@headroom-marketplace": true
  }
}
